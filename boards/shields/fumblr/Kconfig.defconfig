if SHIELD_FUMBLR_LEFT

config ZMK_KEYBOARD_NAME
	default "Fumblr"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

endif

if SHIELD_FUMBLR_RIGHT

config ZMK_KEYBOARD_NAME
	default "Fumblr Right"
	
endif

if SHIELD_FUMBLR_LEFT || SHIELD_FUMBLR_RIGHT

config ZMK_SPLIT
	default y
 
if ZMK_DISPLAY

config I2C
	default y

config SSD1306
	default y

#config SSD1306_REVERSE_MODE
#	default y

endif # ZMK_DISPLAY

endif
