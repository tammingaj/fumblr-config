#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NUM 1
#define NAV 2

/ {
  combos {
    compatible = "zmk,combos";

    combo_BTCLR {
      timeout-ms = <50>;
      key-positions = <22 23 24>;
      layers = <BASE>;
      bindings = <&bt BT_CLR>;
    };

    combo_BT1 {
      timeout-ms = <50>;
      key-positions = <41 42>;
      layers = <BASE>;
      bindings = <&bt BT_SEL 1>;
    };

    combo_BT2 {
      timeout-ms = <50>;
      key-positions = <43 44>;
      layers = <BASE>;
      bindings = <&bt BT_SEL 2>;
    };

    combo_Z {
          timeout-ms = <50>;
          key-positions = <22 24>;
          layers = <BASE>;
          bindings = <&kp Z>;
        };
  };

  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <250>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&kp>;
    };
  };
  keymap {
    compatible = "zmk,keymap";

    Base_layer {
      bindings = <
        &hm LGUI A  &hm LALT S   &hm LSHFT H  &hm LCTRL T  &lt NUM CAPSLOCK      &lt NAV RETURN  &hm RCTRL N  &hm RSHFT E    &hm RALT O  &hm RGUI I
        &kp Z       &kp Q        &none        &kp B        &kp COMMA             &none           &kp Y        &kp BACKSPACE  &none       &none
        &kp ESC     &kp W        &kp D        &kp R        &none                 &none           &kp F        &kp U          &kp P       &kp INS
        &none       &kp X        &none        &kp G        &none                 &kp SPACE       &kp J        &kp DEL        &none       &none
        &kp TAB     &kp M        &kp C        &kp V        &none                 &none           &kp K        &kp L          &kp DOT     &none
        &none       &none        &none        &none        &none                 &none           &none        &none          &none       &none
      >;
    };

    Num_layer {
      bindings = <
        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &trans              &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9      &kp NUMBER_0
        &none         &none         &none         &none         &none               &none         &none         &none          &none             &kp F11
        &none         &kp MINUS     &kp PLUS      &kp EQUAL     &none               &none         &kp SLASH     &kp BACKSLASH  &kp SINGLE_QUOTE  &none
        &none         &none         &none         &kp F5        &none               &none         &none         &none          &none             &kp F4
        &kp F1        &kp F2        &kp F3        &kp F4        &none               &kp F6        &kp F7        &kp F8         &kp F9            &kp F10
        &none         &none         &none         &none         &none               &none         &none         &none          &none             &none
      >;
    };

    Nav_layer {
      bindings = <
        &hm LGUI LT  &hm LALT LEFT_BRACKET  &hm LSHFT LEFT_PARENTHESIS  &hm LCTRL LEFT_BRACE  &kp LC(LA(DEL))      &trans  &kp LC(C)  &kp LC(V)   &kp LC(X)  &none
        &kp TILDE    &none                  &none                       &none                 &none                &none   &kp LEFT   &kp HOME    &none      &none
        &kp LT       &kp LEFT_BRACKET       &kp LEFT_PARENTHESIS        &kp LEFT_BRACE        &none                &none   &kp UP     &kp PG_UP   &none      &none
        &none        &none                  &none                       &kp SEMICOLON         &none                &none   &kp RIGHT  &kp END     &none      &none
        &kp GT       &kp RIGHT_BRACKET      &kp RIGHT_PARENTHESIS       &kp RIGHT_BRACE       &kp LC(LA(DEL))      &none   &kp DOWN   &kp PG_DN   &none      &kp PRINTSCREEN
        &none        &none                  &none                       &none                 &none                &none   &none      &none       &none      &none
      >;
    };

  };
};