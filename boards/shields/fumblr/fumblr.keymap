#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NUM 1
#define NAV 2
#define FUNC 3

/ {
  combos {
    compatible = "zmk,combos";

    combo_BTCLR {
      timeout-ms = <50>;
      key-positions = <42 43>;
      layers = <NAV>;
      bindings = <&bt BT_CLR>;
    };

    combo_BT1 {
      timeout-ms = <50>;
      key-positions = <20 21>;
      layers = <NAV>;
      bindings = <&bt BT_SEL 1>;
    };

    combo_BT2 {
      timeout-ms = <50>;
      key-positions = <40 41>;
      layers = <NAV>;
      bindings = <&bt BT_SEL 2>;
    };

    combo_J {
      timeout-ms = <50>;
      key-positions = <46 27>;
      layers = <BASE>;
      bindings = <&kp J>;
    };

    combo_Q {
      timeout-ms = <50>;
      key-positions = <21 22>;
      layers = <BASE>;
      bindings = <&kp Q>;
    };

    combo_Z {
      timeout-ms = <50>;
      key-positions = <41 42>;
      layers = <BASE>;
      bindings = <&kp Z>;
    };

    combo_X {
      timeout-ms = <50>;
      key-positions = <42 43>;
      layers = <BASE>;
      bindings = <&kp X>;
    };
  };

  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <250>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&kp>;
    };
  };
  keymap {
    compatible = "zmk,keymap";

    Base_layer {
      bindings = <
        &none       &none        &none        &none        &none                &none           &none        &none          &none       &none
        &kp ESC     &none        &kp C        &kp B        &kp COMMA            &kp RETURN      &kp F        &kp BACKSPACE  &kp DEL     &none
        &none       &kp W        &kp D        &kp R        &kp CAPSLOCK         &lt FUNC J      &kp Y        &kp U          &kp P       &kp INS
        &kp TAB     &kp M        &kp V        &kp G        &lt NUM CAPSLOCK     &kp SPACE       &kp K        &kp L          &kp DOT     &none
        &hm LGUI A  &hm LALT S   &hm LSHFT H  &hm LCTRL T  &none                &lt NAV RETURN  &hm RCTRL N  &hm RSHFT E    &hm RALT O  &hm RGUI I
      >;
    };

    Num_layer {
      bindings = <
        &none         &none         &none         &none         &none               &none         &none         &none          &none             &none
        &none         &none         &none         &none         &none               &none         &none         &none          &kp TILDE         &none
        &none         &kp MINUS     &kp PLUS      &kp EQUAL     &none               &none         &kp SLASH     &kp BACKSLASH  &kp SINGLE_QUOTE  &none
        &none         &none         &none         &kp NUMBER_5  &trans              &none         &none         &none          &none             &none
        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &none               &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9      &kp NUMBER_0
      >;
    };

    Nav_layer {
      bindings = <
        &none   &none              &none                  &none            &none               &none   &none      &none       &none      &none
        &none   &none              &none                  &none            &none               &trans  &kp LEFT   &kp HOME    &kp LC(X)  &none
        &kp LT  &kp LEFT_BRACKET   &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &none               &none   &kp UP     &kp PG_UP   &kp LC(V)  &none
        &none   &none              &none                  &kp SEMICOLON    &kp LC(LA(DEL))     &none   &kp RIGHT  &kp END     &none      &none
        &kp GT  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &none               &none   &kp DOWN   &kp PG_DN   &kp LC(C)  &kp PRINTSCREEN
      >;
    };

    Func_layer {
      bindings = <
        &none    &none    &none   &none   &none        &none   &none   &none   &none   &none
        &none    &none    &none   &none   &none        &none   &kp F6  &none   &none   &none
        &kp F11  &kp F12  &none   &none   &none        &none   &none   &none   &none   &none
        &none    &none    &none   &none   &none        &trans  &none   &none   &none   &none
        &kp F1   &kp F2   &kp F3  &kp F4  &kp F5       &none   &kp F7  &kp F8  &kp F9  &kp F10
      >;
    };

  };
};